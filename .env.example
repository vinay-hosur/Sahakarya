APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=sahakarya
POSTGRES_USER=sahakarya
POSTGRES_PASSWORD=sahakarya
WEB_PORT=8080
DATABASE_URL=postgresql+psycopg://sahakarya:sahakarya@127.0.0.1:5432/sahakarya
DB_CONNECT_TIMEOUT_SECONDS=1
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_DAYS=14
# Optional for local HTTP development; production cookies are secure by default.
SESSION_COOKIE_SECURE=false
# Generate a Fernet key before connecting MCP providers; keep it out of version control.
INTEGRATION_ENCRYPTION_KEY=
# Optional grounded reasoning. Configure one or more provider key/model pairs.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
XAI_API_KEY=
XAI_MODEL=
# Optional: openai, anthropic, gemini, groq, or xai. Defaults to the first configured provider.
DEFAULT_REASONING_PROVIDER=
REASONING_CONNECT_TIMEOUT_SECONDS=10
REASONING_READ_TIMEOUT_SECONDS=60
# Slack OAuth is optional. The callback must match the HTTPS URL configured in your Slack app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_FRONTEND_URL=http://localhost:5173
SLACK_USER_SCOPES=search:read.public,search:read.private,search:read.mpim,search:read.im,channels:history,groups:history,mpim:history,im:history
