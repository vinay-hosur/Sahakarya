APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=sahakarya
POSTGRES_USER=sahakarya
POSTGRES_PASSWORD=sahakarya
WEB_PORT=8080
DATABASE_URL=postgresql+psycopg://sahakarya:sahakarya@127.0.0.1:5432/sahakarya
DB_CONNECT_TIMEOUT_SECONDS=1
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_DAYS=14
# Optional for local HTTP development; production cookies are secure by default.
SESSION_COOKIE_SECURE=false
# Generate a Fernet key before connecting MCP providers; keep it out of version control.
INTEGRATION_ENCRYPTION_KEY=
# Optional Cloudflare R2 (S3-compatible) storage for uploads above 5 MiB and durable file storage.
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
# Optional Resend email delivery for workspace invitations. Without it, share the secure invite link.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
# Optional grounded reasoning. Configure one or more provider key/model pairs.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
XAI_API_KEY=
XAI_MODEL=
# Optional Cloudflare Workers AI provider. The default model is Gemma 4 26B A4B.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
# Optional: openai, anthropic, gemini, groq, xai, or cloudflare.
DEFAULT_REASONING_PROVIDER=
REASONING_CONNECT_TIMEOUT_SECONDS=10
REASONING_READ_TIMEOUT_SECONDS=60
# Slack OAuth is optional. The callback must match the HTTPS URL configured in your Slack app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_FRONTEND_URL=http://localhost:5173
SLACK_USER_SCOPES=search:read.public,search:read.private,search:read.mpim,search:read.im,channels:history,groups:history,mpim:history,im:history
